# SentinelAI Environment Variables Configuration

# Security & Tokens
SECRET_KEY=sentinel-ai-super-secret-production-key-2025-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default for zero-friction local run; PostgreSQL ready)
DATABASE_URL=sqlite:///sentinel.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_ai

# Engine & Machine Learning Modes
AI_PROVIDER=hybrid
ACTIVE_MODEL="TF-IDF + Logistic Regression (Calibrated)"
SEED_DEMO_DATA=True

# Networking
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
